<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OrderKit.Tests</AssemblyName>
    <RootNamespace>OrderKit.Tests</RootNamespace>
    <!-- LangVersion is deliberately NOT set. It defaults from the TargetFramework,
         which is what makes the family axis one number instead of two. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Mirrors paket.lock pins for this project's paket.references. The platform worker
         runs a plain `dotnet restore` with no paket tool, so the graph Paket.Restore.targets
         would emit is declared here; paket.dependencies / paket.lock stay the source of truth. -->
    <!-- Test host + adapter + collector: required by coverlet, altcover and stryker-net.
         The planted CVE packages arrive transitively from OrderKit; pinning
         Newtonsoft.Json 9.0.1 here directly is a NU1605 downgrade against Test.Sdk. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OrderKit\OrderKit.csproj" />
  </ItemGroup>

</Project>
