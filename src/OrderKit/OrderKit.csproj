<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OrderKit</AssemblyName>
    <RootNamespace>OrderKit</RootNamespace>
    <!-- LangVersion is deliberately NOT set. It defaults from the TargetFramework,
         which is what makes the family axis one number instead of two. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Mirrors paket.lock pins for this project's paket.references. The platform worker
         runs a plain `dotnet restore` with no paket tool, so the graph Paket.Restore.targets
         would emit is declared here; paket.dependencies / paket.lock stay the source of truth. -->
    <PackageReference Include="Newtonsoft.Json" Version="9.0.1" />
    <PackageReference Include="System.Net.Http" Version="4.3.0" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.2.3" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.0" />
    <PackageReference Include="BouncyCastle" Version="1.8.1" />
  </ItemGroup>

</Project>
